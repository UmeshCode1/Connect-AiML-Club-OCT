{
  "name": "connect-aiml-club-oct",
  "version": "1.0.0",
  "private": true,
  "description": "AIML Club OCT — Connect: Official Unified Operational and Student-Facing Platform",
  "author": "AIML Club OCT",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:all": "concurrently \"npm run dev --workspace=apps/web\" \"npm run dev --workspace=apps/api\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:api && npm run test:web",
    "test:api": "pytest apps/api/tests",
    "test:web": "npm run test --workspace=apps/web --if-present"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
