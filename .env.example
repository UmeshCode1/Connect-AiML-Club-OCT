# ==============================================================================
# AIML CLUB OCT — CONNECT
# Master Environment Variables Configuration (.env.example)
#
# IMPORTANT:
# 1. Never commit the actual .env file or real secrets to version control.
# 2. Duplicate this file as .env in development and fill in appropriate test credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Domain Configuration
# ------------------------------------------------------------------------------
ENVIRONMENT=development
PORT=8000
API_BASE_URL=http://localhost:8000
WEB_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","https://app.aimlcluboct.in","https://admin.aimlcluboct.in","https://aimlcluboct.in"]

# Next.js Public Domain References
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/v1
NEXT_PUBLIC_MAIN_SITE_URL=https://aimlcluboct.in

# ------------------------------------------------------------------------------
# 2. Database & Supabase Configuration
# ------------------------------------------------------------------------------
# Supabase PostgreSQL Connection URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Auth & Public API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
# CRITICAL: Service role key must NEVER be exposed to frontend applications
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# ------------------------------------------------------------------------------
# 3. Google Drive & Cloud Integration
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@your-gcp-project.iam.gserviceaccount.com
# Base64 encoded or string representation of Google Service Account credentials JSON
GOOGLE_SERVICE_ACCOUNT_KEY_JSON=""
# Root managed folder ID in Google Drive for AIML Club Media
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-google-drive-root-folder-id

# ------------------------------------------------------------------------------
# 4. Tally & Google Sheets Integrations
# ------------------------------------------------------------------------------
TALLY_WEBHOOK_SIGNING_SECRET=your-tally-webhook-secret-here
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=sheets-service@your-gcp-project.iam.gserviceaccount.com

# ------------------------------------------------------------------------------
# 5. Email Notifications (Resend / SMTP)
# ------------------------------------------------------------------------------
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM_ADDRESS=notifications@aimlcluboct.in
EMAIL_FROM_NAME="AIML Club OCT Connect"

# ------------------------------------------------------------------------------
# 6. Biometrics & AI Vector Processing
# ------------------------------------------------------------------------------
FACE_EMBEDDING_DIMENSION=512
FACE_MODEL_VERSION="insightface-v1"
FACE_SIMILARITY_THRESHOLD=0.68

# ------------------------------------------------------------------------------
# 7. Security, Session & Rate Limiting
# ------------------------------------------------------------------------------
SECRET_KEY=change-this-to-a-very-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
RATE_LIMIT_PER_MINUTE=120
